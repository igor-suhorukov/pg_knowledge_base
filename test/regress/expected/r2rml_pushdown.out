SELECT pd_check('PREFIX ex: <http://example.com/v#>
SELECT ?n ?b WHERE { ?p ex:name ?n . OPTIONAL { ?p ex:boss ?x . ?x ex:name ?b } ?p ?any ?v }');
                        pd_check                         
---------------------------------------------------------
 same: Project LeftJoin Join QuadPattern QuadPattern SQL
