-- a BIND between two basic graph patterns, lifted over their join
SELECT pd_check('PREFIX ex: <http://example.com/v#>
SELECT ?n ?k ?l WHERE { ?p ex:name ?n . BIND(STRLEN(?n) AS ?k) ?p ex:city ?c . ?c ex:label ?l }');
